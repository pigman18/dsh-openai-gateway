{
  "name": "dsh-openai-gateway",
  "version": "1.0.2",
  "displayName": "DSH OpenAI Gateway",
  "description": "Exposes every model of every provider configured in DeepSeek Harness as an OpenAI-compatible endpoint on a fixed loopback port, with a sidebar page for the base URL, the API key, the port and every model id.",
  "author": "pigman18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pigman18/dsh-openai-gateway.git"
  },
  "homepage": "https://github.com/pigman18/dsh-openai-gateway#readme",
  "bugs": {
    "url": "https://github.com/pigman18/dsh-openai-gateway/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openai",
    "openai-compatible",
    "gateway",
    "model-provider",
    "llm-router"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "test": "node tests/catalog-refresh.spec.mjs"
  },
  "icon": "assets/icon-128.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tests/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
